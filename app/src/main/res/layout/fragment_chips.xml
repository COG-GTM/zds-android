<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="HardcodedText">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selectable"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/selectableChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:checkedChip="@id/chipAll"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.zebra.zds.ZdsChip
            android:id="@+id/chipAll"
            style="@style/Zds.Chip.Selectable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All" />

        <com.zebra.zds.ZdsChip
            android:id="@+id/chipScanners"
            style="@style/Zds.Chip.Selectable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scanners" />

        <com.zebra.zds.ZdsChip
            android:id="@+id/chipPrinters"
            style="@style/Zds.Chip.Selectable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Printers" />

        <com.zebra.zds.ZdsChip
            android:id="@+id/chipTablets"
            style="@style/Zds.Chip.Selectable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tablets" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/selectableResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        tools:text="Selected: All" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Filter"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/filterChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.zebra.zds.ZdsChip
            android:id="@+id/chipInStock"
            style="@style/Zds.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="In stock" />

        <com.zebra.zds.ZdsChip
            android:id="@+id/chipOnSale"
            style="@style/Zds.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On sale" />

        <com.zebra.zds.ZdsChip
            android:id="@+id/chipNewArrivals"
            style="@style/Zds.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New arrivals" />

        <com.zebra.zds.ZdsChip
            android:id="@+id/chipRugged"
            style="@style/Zds.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rugged" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/filterResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        tools:text="Active filters: In stock" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Disabled"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.zebra.zds.ZdsChip
            style="@style/Zds.Chip.Selectable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Selectable" />

        <com.zebra.zds.ZdsChip
            style="@style/Zds.Chip.Selectable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:enabled="false"
            android:text="Selected" />

        <com.zebra.zds.ZdsChip
            style="@style/Zds.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:enabled="false"
            android:text="Filter" />
    </com.google.android.material.chip.ChipGroup>
</androidx.appcompat.widget.LinearLayoutCompat>
