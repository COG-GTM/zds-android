<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/iconGalleryLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <com.zebra.zds.ZdsSearchView
        android:id="@+id/iconSearch"
        style="@style/Zds.SearchView.Layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:queryHint="@string/icon_gallery_search_hint"
        android:theme="@style/Zds.SearchView.Layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.zebra.zds.ZdsTabLayout
        android:id="@+id/iconStyleTabs"
        style="@style/Zds.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="0dp"
        android:theme="@style/Zds.TabLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconSearch"
        app:tabGravity="fill"
        app:tabMode="fixed">

        <com.zebra.zds.ZdsTabItem
            android:id="@+id/tabAll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/icon_gallery_tab_all" />

        <com.zebra.zds.ZdsTabItem
            android:id="@+id/tabRound"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/icon_gallery_tab_round" />

        <com.zebra.zds.ZdsTabItem
            android:id="@+id/tabSharp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/icon_gallery_tab_sharp" />

        <com.zebra.zds.ZdsTabItem
            android:id="@+id/tabOutline"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/icon_gallery_tab_outline" />

    </com.zebra.zds.ZdsTabLayout>

    <TextView
        android:id="@+id/iconCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconStyleTabs"
        tools:text="1424 icons" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/iconGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconCount"
        tools:listitem="@layout/item_icon_gallery" />

    <TextView
        android:id="@+id/iconEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/icon_gallery_empty"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iconGrid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iconGrid" />

</androidx.constraintlayout.widget.ConstraintLayout>
