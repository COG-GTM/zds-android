<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chipList"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="16dp"
    app:divider="@drawable/divider"
    app:showDividers="middle">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/selectableChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.zebra.zds.ZdsChip
            android:id="@+id/selectableAll"
            style="@style/Zds.Chip.Selectable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="All"
            app:chip_style="selectable"
            tools:ignore="HardcodedText" />

        <com.zebra.zds.ZdsChip
            android:id="@+id/selectableActive"
            style="@style/Zds.Chip.Selectable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active"
            app:chip_style="selectable"
            tools:ignore="HardcodedText" />

        <com.zebra.zds.ZdsChip
            android:id="@+id/selectableDisabled"
            style="@style/Zds.Chip.Selectable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Archived"
            app:chip_style="selectable"
            tools:ignore="HardcodedText" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/filterChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="false">

        <com.zebra.zds.ZdsChip
            android:id="@+id/filterPrinters"
            style="@style/Zds.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Printers"
            app:chip_style="filter"
            tools:ignore="HardcodedText" />

        <com.zebra.zds.ZdsChip
            android:id="@+id/filterScanners"
            style="@style/Zds.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Scanners"
            app:chip_style="filter"
            tools:ignore="HardcodedText" />

        <com.zebra.zds.ZdsChip
            android:id="@+id/filterDisabled"
            style="@style/Zds.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Tablets"
            app:chip_style="filter"
            tools:ignore="HardcodedText" />
    </com.google.android.material.chip.ChipGroup>
</androidx.appcompat.widget.LinearLayoutCompat>
