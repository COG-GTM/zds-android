<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:zebra="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:divider="@drawable/divider"
        app:showDividers="middle">

        <com.zebra.zds.ZdsStepper
            android:id="@+id/stepper"
            style="@style/Zds.Stepper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            zebra:currentStep="1"
            zebra:steps="@array/checkout_steps"
            zebra:stepsClickable="true" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/stepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.Zds.TitleMedium" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/stepDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:textAppearance="@style/TextAppearance.Zds.BodySmall" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.zebra.zds.ZdsButton
                android:id="@+id/back"
                style="@style/Zds.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Back"
                android:theme="@style/Zds.Button.Outline" />

            <com.zebra.zds.ZdsButton
                android:id="@+id/next"
                style="@style/Zds.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next"
                android:theme="@style/Zds.Button.Primary" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.zebra.zds.ZdsStepper
            android:id="@+id/stepperSharp"
            style="@style/Zds.Stepper.Sharp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            zebra:currentStep="2"
            zebra:steps="@array/onboarding_steps" />

        <com.zebra.zds.ZdsStepper
            android:id="@+id/stepperCompact"
            style="@style/Zds.Stepper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            zebra:currentStep="3"
            zebra:showLabels="false"
            zebra:stepCount="6" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</ScrollView>
