<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_search_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <com.zebra.zds.ZdsSearchView
        android:id="@+id/navigation_search"
        style="@style/Zds.SearchView.Layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Zds.SearchView.Layout"
        app:queryHint="@string/navigation_search_hint" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/navigation_search_empty"
        style="@style/TextAppearance.Zds.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/navigation_search_empty"
        android:textColor="@color/zebra_hint"
        android:visibility="gone" />

</androidx.appcompat.widget.LinearLayoutCompat>
