<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearance.Zds.Chip" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Zds.Chip.Sharp" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="Zds.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@drawable/chip_background_selector</item>
        <item name="chipStrokeColor">@drawable/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipIconTint">@drawable/chip_icon_selector</item>
        <item name="checkedIconTint">@drawable/chip_icon_selector</item>
        <item name="closeIconTint">@drawable/chip_icon_selector</item>
        <item name="chipIconSize">18dp</item>
        <item name="closeIconSize">18dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="rippleColor">@color/zebra_grey_subtle_stroke</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Zds.Chip</item>
        <item name="android:textColor">@drawable/chip_text_selector</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="android:checkable">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
    </style>

    <style name="Zds.Chip.Sharp" parent="Zds.Chip">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Zds.Chip.Sharp</item>
    </style>

    <style name="Zds.Chip.Selectable" parent="Zds.Chip">
        <item name="android:checkable">true</item>
        <item name="checkedIcon">@drawable/ic_check_mark_round</item>
        <item name="checkedIconVisible">true</item>
        <item name="closeIconVisible">false</item>
    </style>

    <style name="Zds.Chip.Selectable.Sharp" parent="Zds.Chip.Selectable">
        <item name="checkedIcon">@drawable/ic_check_mark_sharp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Zds.Chip.Sharp</item>
    </style>

    <style name="Zds.Chip.Filter" parent="Zds.Chip">
        <item name="android:checkable">true</item>
        <item name="checkedIcon">@drawable/ic_check_mark_round</item>
        <item name="checkedIconVisible">true</item>
        <item name="closeIcon">@drawable/ic_close_round</item>
        <item name="closeIconVisible">true</item>
    </style>

    <style name="Zds.Chip.Filter.Sharp" parent="Zds.Chip.Filter">
        <item name="checkedIcon">@drawable/ic_check_mark_sharp</item>
        <item name="closeIcon">@drawable/ic_close_sharp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Zds.Chip.Sharp</item>
    </style>

    <style name="Zds.ChipGroup" parent="Widget.Material3.ChipGroup">
        <item name="chipSpacingHorizontal">8dp</item>
        <item name="chipSpacingVertical">8dp</item>
    </style>

</resources>
