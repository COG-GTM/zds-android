<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Zds.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="android:textColor">@drawable/chip_text_selector</item>
        <item name="chipBackgroundColor">@drawable/chip_background_selector</item>
        <item name="chipStrokeColor">@drawable/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">4dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="rippleColor">@color/zebra_blue_pressed_outline</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <style name="Zds.Chip.Selectable" parent="Zds.Chip" />

    <style name="Zds.Chip.Selectable.Sharp" parent="Zds.Chip.Selectable">
        <item name="chipCornerRadius">0dp</item>
    </style>

    <style name="Zds.Chip.Filter" parent="Zds.Chip">
        <item name="checkedIconVisible">true</item>
        <item name="checkedIcon">@drawable/ic_check_mark_round</item>
        <item name="checkedIconTint">@color/zebra_blue_enabled</item>
        <item name="chipIconSize">18dp</item>
    </style>

    <style name="Zds.Chip.Filter.Sharp" parent="Zds.Chip.Filter">
        <item name="chipCornerRadius">0dp</item>
        <item name="checkedIcon">@drawable/ic_check_mark_sharp</item>
    </style>

</resources>
