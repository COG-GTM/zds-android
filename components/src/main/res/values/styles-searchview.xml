<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Zds.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="collapseIcon">@drawable/ic_arrow_back_sharp</item>
        <item name="searchHintIcon">@null</item>
        <item name="iconTint">@color/colorAccent</item>
        <item name="colorControlNormal">@color/colorAccent</item>
        <item name="queryHint">Search</item>
        <item name="closeIconEnabled">true</item>
        <item name="android:textColor">@color/textPrimaryVariant</item>
        <item name="android:textColorHint">@color/zebra_grey_subtle_icon</item>
        <item name="android:maxWidth">10000dp</item>
    </style>

    <style name="Zds.SearchView.Layout" parent="Zds.SearchView">
        <item name="iconifiedByDefault">false</item>
        <item name="colorSurface">@color/textPrimary</item>
        <item name="colorControlActivated">@color/zebra_blue_enabled</item>
        <item name="android:textColorPrimary">@color/textPrimaryVariant</item>
        <item name="queryBackground">@null</item>
        <item name="colorAccent">@color/zebra_blue_enabled</item>
    </style>

</resources>
